# Broken git backups
.git.broken-backup-*/

# Archive of legacy assets (S.6)
archive/

# Python
*.pyc
__pycache__/
*.pyo
*.egg-info/
.venv/
.venv-win/
venv/

# Node
node_modules/
dist/

# Env (never commit)
.env
.env.*
!.env.example

# Local data
data/
workspace/
*.sqlite
*.sqlite3
*.db

# Test/cache
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Tool state (process artifacts, not source)
.zcode/
.workbuddy/
# .agents/skills/ and .agents/agents/ are project config (ZCode skills + subagents), keep in git
.agents/*
!.agents/skills/
!.agents/agents/

# P4 build artifacts — never commit compiled binaries. Keep reproducible build
# sources and smoke tooling visible to Git.
services/control-core/scripts/nuitka-build/*
!services/control-core/scripts/nuitka-build/build.ps1
!services/control-core/scripts/nuitka-build/requirements-build.lock
!services/control-core/scripts/nuitka-build/sidecar.py
!services/control-core/scripts/nuitka-build/control_core_sidecar.py
!services/control-core/scripts/nuitka-build/create_bootstrap_db.py
!services/control-core/scripts/nuitka-build/smoke_client.py
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/.cargo/
*.exe
*.dll
!**/testfixtures/**

# Nuitka sidecar build output (regenerate via scripts/nuitka-build/build.ps1)
apps/desktop/src-tauri/resources/sidecar/
nuitka-crash-report.xml
docs/agent-reports/
.mimosa/
